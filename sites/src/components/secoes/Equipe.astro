---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { ProfissionalComImagem } from "../../ficha/imagens.ts";

interface Props {
  profissionais: ProfissionalComImagem<ImageMetadata>[];
}
const { profissionais } = Astro.props;
---

<section class="secao equipe" id="equipe" aria-labelledby="equipe-titulo">
  <div class="conteudo">
    <h2 class="secao__titulo" id="equipe-titulo">Equipe</h2>
    <ul class="equipe__lista">
      {
        profissionais.map((p) => (
          <li class="profissional">
            {p.imagem ? (
              <Image class="profissional__foto" src={p.imagem} alt={`Foto de ${p.nome}`} widths={[160, 320]} sizes="112px" />
            ) : (
              <span class="profissional__inicial" aria-hidden="true">{p.nome.slice(0, 1)}</span>
            )}
            <span class="profissional__nome">{p.nome}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
