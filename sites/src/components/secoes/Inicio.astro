---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import type { FotoComImagem } from "../../ficha/imagens.ts";
import type { Ficha } from "../../ficha/tipos.ts";
import type { Variantes } from "../../tema/layouts.ts";

interface Props {
  ficha: Ficha;
  foto: FotoComImagem<ImageMetadata> | null;
  variante: Variantes["inicio"];
}
const { ficha, foto, variante } = Astro.props;
---

<section class:list={["inicio", `inicio--${variante}`, { "inicio--sem-foto": !foto }]} aria-labelledby="inicio-titulo">
  <div class="inicio__texto conteudo">
    <p class="inicio__nome marca">{ficha.nome}</p>
    <h1 class="inicio__titulo" id="inicio-titulo">{ficha.textos.titulo}</h1>
    <p class="inicio__subtitulo">{ficha.textos.subtitulo}</p>
    <button type="button" class="botao botao--grande" data-agendar>{ficha.textos.chamada}</button>
  </div>
  {
    foto && (
      <div class="inicio__foto">
        <Picture src={foto.imagem} alt={foto.alt} widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" formats={["webp"]} loading="eager" fetchpriority="high" style={foto.foco ? `object-position: ${foto.foco}` : undefined} />
      </div>
    )
  }
</section>
{ficha.textos.sobre && <p class="sobre conteudo">{ficha.textos.sobre}</p>}
