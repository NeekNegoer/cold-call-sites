---
// Raiz das prévias: publicada vazia, para ninguém descobrir quais negócios têm prévia.
// Só no computador (modo local) ela lista as páginas, para navegar entre exemplos e prévias.
import { caminhosEstaticos } from "../conteudo.ts";
import { modoAtual } from "../modo.ts";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const caminhos = modoAtual() === "local" ? caminhosEstaticos().map((p) => p.params.previa) : [];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Prévias</title>
  </head>
  <body>
    {
      caminhos.length > 0 && (
        <ul>
          {caminhos.map((c) => (
            <li>
              <a href={`${base}/${c}/`}>{c}</a>
            </li>
          ))}
        </ul>
      )
    }
  </body>
</html>
