---
// O texto usa a fonte do sistema (SF no iPhone). A fonte do par entra só na marca, o nome do negócio.
// Servida pelo próprio site (subconjunto latino): o navegador só baixa a que a página usa.
import "@fontsource/playfair-display/latin-600.css";
import "@fontsource/oswald/latin-500.css";
import "@fontsource/space-grotesk/latin-500.css";
import "@fontsource/cormorant-garamond/latin-600.css";
import "@fontsource/bodoni-moda/latin-500.css";
import "@fontsource/dm-serif-display/latin-400.css";
import "../estilos/base.css";
import "../estilos/secoes.css";
import "../estilos/agenda.css";
import "../estilos/layouts/classica.css";
import "../estilos/layouts/moderna-escura.css";
import "../estilos/layouts/minimal.css";
import type { Ficha } from "../ficha/tipos.ts";
import { corDoTextoSobre } from "../tema/contraste.ts";
import { parDeFontes } from "../tema/fontes.ts";

interface Props {
  ficha: Ficha;
  titulo: string;
}
const { ficha, titulo } = Astro.props;
const fontes = parDeFontes(ficha.tema.fontes);
if (!fontes) throw new Error(`Fontes desconhecidas: ${ficha.tema.fontes}`);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const variaveis: Record<string, string> = {
  "--cor-fundo": ficha.tema.fundo,
  "--cor-superficie": ficha.tema.superficie,
  "--cor-texto": ficha.tema.texto,
  "--cor-destaque": ficha.tema.destaque,
  "--cor-sobre-destaque": corDoTextoSobre(ficha.tema.destaque),
  "--fonte-marca": `'${fontes.titulo}', Georgia, serif`,
  "--peso-marca": String(fontes.pesoTitulo),
};
const estilo = Object.entries(variaveis).map(([k, v]) => `${k}: ${v}`).join("; ");
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content={ficha.tema.fundo} />
    <title>{titulo}</title>
    <link rel="icon" href={`${base}/icone.svg`} type="image/svg+xml" />
  </head>
  <body style={estilo} data-layout={ficha.layout}>
    <slot />
  </body>
</html>
