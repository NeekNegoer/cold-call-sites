{
  "name": "cold",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"prospeccao/**/*.test.ts\" \"painel/**/*.test.ts\" \"sites/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "buscar": "node --env-file-if-exists=.env prospeccao/cli/buscar.ts",
    "lote": "node prospeccao/cli/lote.ts",
    "detalhar": "node --env-file-if-exists=.env prospeccao/cli/detalhar.ts",
    "limpar": "node prospeccao/cli/limpar.ts",
    "painel:construir": "node --env-file-if-exists=senha.env painel/cli/construir.ts",
    "painel:local": "python3 -m http.server 4173 --bind 127.0.0.1 --directory painel/dist",
    "painel:publicar": "git -C painel/dist add index.html .nojekyll && git -C painel/dist commit -q -m 'Atualiza o caderno' && git -C painel/dist push -q",
    "sites:local": "ASTRO_TELEMETRY_DISABLED=1 astro dev --root sites --ignore-lock",
    "ficha": "node sites/cli/ficha.ts",
    "previas:publicar": "node sites/cli/publicar.ts",
    "previa:remover": "node sites/cli/remover.ts",
    "sites:prints": "PLAYWRIGHT_BROWSERS_PATH=0 node sites/cli/prints.ts",
    "sites:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 node --test \"sites/e2e/*.e2e.ts\""
  },
  "devDependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/node": "^26.6.5",
    "astro": "7.3.8",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
