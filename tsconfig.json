{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "prospeccao/**/*.ts",
    "painel/**/*.ts",
    "sites/src/**/*.ts",
    "sites/cli/**/*.ts",
    "sites/e2e/**/*.ts",
    "sites/*.test.ts"
  ]
}
